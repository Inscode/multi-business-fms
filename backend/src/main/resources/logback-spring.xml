<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback-spring.xml — Spring Boot's preferred Logback config file.

  WHY THIS EXISTS:
    In development  → logs print to the console (you read them live).
    In production   → logs push to Grafana Loki via HTTP (searchable forever,
                      even after the server restarts or the process dies).

  WHY <springProperty> instead of ${ENV_VAR} directly:
    Plain Logback ${VAR} only reads JVM system properties (-DVAR=...), NOT OS
    environment variables from the shell/systemd. <springProperty> uses Spring's
    Environment which DOES include OS env vars — that's the correct bridge here.
-->
<configuration>

  <!-- Pull env vars into logback via Spring's Environment (reads OS env vars correctly) -->
  <springProperty name="lokiUrl"      source="GRAFANA_LOKI_URL"      defaultValue="http://localhost:3100"/>
  <springProperty name="lokiUsername" source="GRAFANA_LOKI_USERNAME"  defaultValue=""/>
  <springProperty name="lokiPassword" source="GRAFANA_LOKI_PASSWORD"  defaultValue=""/>

  <!-- ── Development: plain console output ─────────────────────────────── -->
  <springProfile name="!prod">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

  <!-- ── Production: push structured logs to Grafana Loki ──────────────── -->
  <springProfile name="prod">
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
      <http>
        <url>${lokiUrl}/loki/api/v1/push</url>
        <auth>
          <username>${lokiUsername}</username>
          <password>${lokiPassword}</password>
        </auth>
      </http>
      <format>
        <label>
          <!--
            Labels = how you FILTER logs in Grafana.
            Keep them low-cardinality (few distinct values) — Loki indexes these.
            DON'T use user IDs or request IDs as labels (too many unique values = slow).
          -->
          <pattern>app=finance-backend,environment=production,level=%level,logger=%logger{20}</pattern>
        </label>
        <message>
          <!-- The actual log line sent as JSON — searchable via LogQL in Grafana -->
          <pattern>{"timestamp":"%d{ISO8601}","level":"%level","thread":"%thread","logger":"%logger{36}","message":"%msg%replace(%xException){'\n',' '}"}%n</pattern>
        </message>
      </format>
      <batchMaxItems>100</batchMaxItems>
      <batchTimeoutMs>5000</batchTimeoutMs>
    </appender>

    <!-- Also keep console output in prod for docker/systemd logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="LOKI" />
      <appender-ref ref="CONSOLE" />
    </root>

    <!-- Silence noisy Spring Security debug logs -->
    <logger name="org.springframework.security" level="WARN" />
    <logger name="org.hibernate.SQL" level="WARN" />
  </springProfile>

</configuration>
